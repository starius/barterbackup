#!/usr/bin/env bash
set -euo pipefail

# Sync the local repository to the throwaway remote workspace.

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
remote_host="${REMOTE_HOST:-barterbackup-dev}"
remote_path="${REMOTE_PATH:-/root/barterbackup-rust2}"

# Remove any git metadata on the remote side so the throwaway workspace never
# points back to this local worktree.
ssh "${remote_host}" "rm -rf ${remote_path@Q}/.git"

# Keep the remote workspace disposable by excluding local build artifacts and
# git metadata. The local checkout remains the source of truth.
rsync \
  --archive \
  --delete \
  --compress \
  --human-readable \
  --exclude '.git' \
  --exclude '.git/' \
  --exclude '.direnv/' \
  --exclude 'result' \
  --exclude 'result-*' \
  --exclude 'rust/target/' \
  --exclude 'target/' \
  "${repo_root}/" \
  "${remote_host}:${remote_path}/"
