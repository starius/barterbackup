
use builtin;
use str;

set edit:completion:arg-completer[bbcli] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'bbcli'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'bbcli'= {
            cand --local-addr 'local_addr is the local daemon endpoint'
            cand --data-dir 'data_dir is the base directory for daemon state and local CLI keys'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand state 'Print daemon state'
            cand init 'Initialize daemon storage with the main password or complete one recovery-mode initialization'
            cand unlock 'Send the main password to the daemon unlock path'
            cand stop 'Ask the daemon to shut down gracefully'
            cand peer 'Manage known peers'
            cand file 'Manage files in the latest encrypted content blob'
            cand config 'Read or update daemon configuration'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;state'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;init'= {
            cand --wait-seconds 'wait_seconds is how long to wait for daemon startup readiness'
            cand --password-stdin 'password_stdin reads the main password from standard input'
            cand --allow-weak-password 'allow_weak_password bypasses the local password-strength gate'
            cand --recovery-mode 'recovery_mode blocks outgoing publication until recovery is finished'
            cand -h 'Print help'
            cand --help 'Print help'
            cand complete 'Complete recovery-mode initialization and allow publication'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;init;complete'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;init;help'= {
            cand complete 'Complete recovery-mode initialization and allow publication'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;init;help;complete'= {
        }
        &'bbcli;init;help;help'= {
        }
        &'bbcli;unlock'= {
            cand --wait-seconds 'wait_seconds is how long to wait for daemon startup readiness'
            cand --password-stdin 'password_stdin reads the main password from standard input'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;stop'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand connect 'Add a peer onion identifier to the daemon''s known peer list'
            cand pin 'Pin a tracked peer so local policy treats it as operator-protected'
            cand unpin 'Remove an existing operator pin from a tracked peer'
            cand list 'Print the daemon''s current peer inventory'
            cand check 'Check one peer''s current copy of our latest local revision'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;peer;connect'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;pin'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;unpin'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;list'= {
            cand --status 'status filters peers by current local transport state'
            cand --with-storage 'with_storage keeps only peers with persisted storage state'
            cand --without-storage 'without_storage keeps only peers without persisted storage state'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'bbcli;peer;check'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;help'= {
            cand connect 'Add a peer onion identifier to the daemon''s known peer list'
            cand pin 'Pin a tracked peer so local policy treats it as operator-protected'
            cand unpin 'Remove an existing operator pin from a tracked peer'
            cand list 'Print the daemon''s current peer inventory'
            cand check 'Check one peer''s current copy of our latest local revision'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;peer;help;connect'= {
        }
        &'bbcli;peer;help;pin'= {
        }
        &'bbcli;peer;help;unpin'= {
        }
        &'bbcli;peer;help;list'= {
        }
        &'bbcli;peer;help;check'= {
        }
        &'bbcli;peer;help;help'= {
        }
        &'bbcli;file'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand list 'Print the names of all files in the latest encrypted content blob'
            cand set 'Add or replace a file in the latest encrypted content blob'
            cand get 'Download a file from the latest encrypted content blob'
            cand delete 'Delete a file from the latest encrypted content blob'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;file;list'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;set'= {
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'bbcli;file;get'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;delete'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;help'= {
            cand list 'Print the names of all files in the latest encrypted content blob'
            cand set 'Add or replace a file in the latest encrypted content blob'
            cand get 'Download a file from the latest encrypted content blob'
            cand delete 'Delete a file from the latest encrypted content blob'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;file;help;list'= {
        }
        &'bbcli;file;help;set'= {
        }
        &'bbcli;file;help;get'= {
        }
        &'bbcli;file;help;delete'= {
        }
        &'bbcli;file;help;help'= {
        }
        &'bbcli;config'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand get 'Print the current configuration and derived storage usage data'
            cand set 'Update one or more configuration fields'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;config;get'= {
            cand --peers-storage 'peers_storage prints only the peer-storage budget field'
            cand --min-replicas 'min_replicas prints only the minimum replica target field'
            cand --resource-policy 'resource_policy prints only the current read-only peer runtime limits'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;config;set'= {
            cand --peers-storage 'peers_storage sets the total bytes allocated to peer storage'
            cand --min-replicas 'min_replicas sets the minimum replica target for our content'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;config;help'= {
            cand get 'Print the current configuration and derived storage usage data'
            cand set 'Update one or more configuration fields'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;config;help;get'= {
        }
        &'bbcli;config;help;set'= {
        }
        &'bbcli;config;help;help'= {
        }
        &'bbcli;help'= {
            cand state 'Print daemon state'
            cand init 'Initialize daemon storage with the main password or complete one recovery-mode initialization'
            cand unlock 'Send the main password to the daemon unlock path'
            cand stop 'Ask the daemon to shut down gracefully'
            cand peer 'Manage known peers'
            cand file 'Manage files in the latest encrypted content blob'
            cand config 'Read or update daemon configuration'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;help;state'= {
        }
        &'bbcli;help;init'= {
            cand complete 'Complete recovery-mode initialization and allow publication'
        }
        &'bbcli;help;init;complete'= {
        }
        &'bbcli;help;unlock'= {
        }
        &'bbcli;help;stop'= {
        }
        &'bbcli;help;peer'= {
            cand connect 'Add a peer onion identifier to the daemon''s known peer list'
            cand pin 'Pin a tracked peer so local policy treats it as operator-protected'
            cand unpin 'Remove an existing operator pin from a tracked peer'
            cand list 'Print the daemon''s current peer inventory'
            cand check 'Check one peer''s current copy of our latest local revision'
        }
        &'bbcli;help;peer;connect'= {
        }
        &'bbcli;help;peer;pin'= {
        }
        &'bbcli;help;peer;unpin'= {
        }
        &'bbcli;help;peer;list'= {
        }
        &'bbcli;help;peer;check'= {
        }
        &'bbcli;help;file'= {
            cand list 'Print the names of all files in the latest encrypted content blob'
            cand set 'Add or replace a file in the latest encrypted content blob'
            cand get 'Download a file from the latest encrypted content blob'
            cand delete 'Delete a file from the latest encrypted content blob'
        }
        &'bbcli;help;file;list'= {
        }
        &'bbcli;help;file;set'= {
        }
        &'bbcli;help;file;get'= {
        }
        &'bbcli;help;file;delete'= {
        }
        &'bbcli;help;config'= {
            cand get 'Print the current configuration and derived storage usage data'
            cand set 'Update one or more configuration fields'
        }
        &'bbcli;help;config;get'= {
        }
        &'bbcli;help;config;set'= {
        }
        &'bbcli;help;help'= {
        }
    ]
    $completions[$command]
}
