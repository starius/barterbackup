
use builtin;
use str;

set edit:completion:arg-completer[bbcli] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'bbcli'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'bbcli'= {
            cand --local-addr 'local_addr is the local daemon endpoint'
            cand --data-dir 'data_dir is the base directory for daemon state and local CLI keys'
            cand -h 'Print help'
            cand --help 'Print help'
            cand state 'Print daemon state'
            cand init 'Initialize daemon storage with the main password'
            cand unlock 'Send the main password to the daemon unlock path'
            cand stop 'Ask the daemon to shut down gracefully'
            cand peer 'Manage known peers'
            cand file 'Manage files in the latest encrypted content blob'
            cand contract 'Inspect and drive contracts with peers'
            cand recovery 'Run recovery and resolve divergent revisions'
            cand config 'Read or update daemon configuration'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;state'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;init'= {
            cand --wait-seconds 'wait_seconds is how long to wait for daemon startup readiness'
            cand --password-stdin 'password_stdin reads the main password from standard input'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;unlock'= {
            cand --wait-seconds 'wait_seconds is how long to wait for daemon startup readiness'
            cand --password-stdin 'password_stdin reads the main password from standard input'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;stop'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand connect 'Add a peer onion identifier to the daemon''s known peer list'
            cand pin 'Pin a tracked peer so local policy treats it as operator-protected'
            cand unpin 'Remove an existing operator pin from a tracked peer'
            cand list 'Print the daemon''s current peer inventory'
            cand export-built-in 'Print the Rust source file for the compiled built-in peer list'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;peer;connect'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;pin'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;unpin'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;list'= {
            cand --status 'status filters peers by current local transport state'
            cand --with-contract 'with_contract keeps only peers with persisted contract state'
            cand --without-contract 'without_contract keeps only peers without persisted contract state'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'bbcli;peer;export-built-in'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;peer;help'= {
            cand connect 'Add a peer onion identifier to the daemon''s known peer list'
            cand pin 'Pin a tracked peer so local policy treats it as operator-protected'
            cand unpin 'Remove an existing operator pin from a tracked peer'
            cand list 'Print the daemon''s current peer inventory'
            cand export-built-in 'Print the Rust source file for the compiled built-in peer list'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;peer;help;connect'= {
        }
        &'bbcli;peer;help;pin'= {
        }
        &'bbcli;peer;help;unpin'= {
        }
        &'bbcli;peer;help;list'= {
        }
        &'bbcli;peer;help;export-built-in'= {
        }
        &'bbcli;peer;help;help'= {
        }
        &'bbcli;file'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand list 'Print the names of all files in the latest encrypted content blob'
            cand set 'Add or replace a file in the latest encrypted content blob'
            cand get 'Download a file from the latest encrypted content blob'
            cand delete 'Delete a file from the latest encrypted content blob'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;file;list'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;set'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;get'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;delete'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;file;help'= {
            cand list 'Print the names of all files in the latest encrypted content blob'
            cand set 'Add or replace a file in the latest encrypted content blob'
            cand get 'Download a file from the latest encrypted content blob'
            cand delete 'Delete a file from the latest encrypted content blob'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;file;help;list'= {
        }
        &'bbcli;file;help;set'= {
        }
        &'bbcli;file;help;get'= {
        }
        &'bbcli;file;help;delete'= {
        }
        &'bbcli;file;help;help'= {
        }
        &'bbcli;contract'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand list 'Print current contract state for known peers'
            cand propose 'Form or renew a contract with a peer and print streamed updates'
            cand check 'Verify a peer contract and print streamed updates'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;contract;list'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;contract;propose'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;contract;check'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;contract;help'= {
            cand list 'Print current contract state for known peers'
            cand propose 'Form or renew a contract with a peer and print streamed updates'
            cand check 'Verify a peer contract and print streamed updates'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;contract;help;list'= {
        }
        &'bbcli;contract;help;propose'= {
        }
        &'bbcli;contract;help;check'= {
        }
        &'bbcli;contract;help;help'= {
        }
        &'bbcli;recovery'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand run 'Recover the newest known local content version from peers'
            cand conflicts 'List unresolved and archived conflicting revisions'
            cand checkout 'Write one conflicting or archived revision to a local directory'
            cand resolve 'Choose the conflicting revision that should stay active'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;recovery;run'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;recovery;conflicts'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;recovery;checkout'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;recovery;resolve'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;recovery;help'= {
            cand run 'Recover the newest known local content version from peers'
            cand conflicts 'List unresolved and archived conflicting revisions'
            cand checkout 'Write one conflicting or archived revision to a local directory'
            cand resolve 'Choose the conflicting revision that should stay active'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;recovery;help;run'= {
        }
        &'bbcli;recovery;help;conflicts'= {
        }
        &'bbcli;recovery;help;checkout'= {
        }
        &'bbcli;recovery;help;resolve'= {
        }
        &'bbcli;recovery;help;help'= {
        }
        &'bbcli;config'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand get 'Print the current configuration and derived storage usage data'
            cand set 'Update one or more configuration fields'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;config;get'= {
            cand --peers-storage 'peers_storage prints only the peer-storage budget field'
            cand --min-replicas 'min_replicas prints only the minimum replica target field'
            cand --resource-policy 'resource_policy prints only the current read-only peer runtime limits'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;config;set'= {
            cand --peers-storage 'peers_storage sets the total bytes allocated to peer storage'
            cand --min-replicas 'min_replicas sets the minimum replica target for our content'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'bbcli;config;help'= {
            cand get 'Print the current configuration and derived storage usage data'
            cand set 'Update one or more configuration fields'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;config;help;get'= {
        }
        &'bbcli;config;help;set'= {
        }
        &'bbcli;config;help;help'= {
        }
        &'bbcli;help'= {
            cand state 'Print daemon state'
            cand init 'Initialize daemon storage with the main password'
            cand unlock 'Send the main password to the daemon unlock path'
            cand stop 'Ask the daemon to shut down gracefully'
            cand peer 'Manage known peers'
            cand file 'Manage files in the latest encrypted content blob'
            cand contract 'Inspect and drive contracts with peers'
            cand recovery 'Run recovery and resolve divergent revisions'
            cand config 'Read or update daemon configuration'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'bbcli;help;state'= {
        }
        &'bbcli;help;init'= {
        }
        &'bbcli;help;unlock'= {
        }
        &'bbcli;help;stop'= {
        }
        &'bbcli;help;peer'= {
            cand connect 'Add a peer onion identifier to the daemon''s known peer list'
            cand pin 'Pin a tracked peer so local policy treats it as operator-protected'
            cand unpin 'Remove an existing operator pin from a tracked peer'
            cand list 'Print the daemon''s current peer inventory'
            cand export-built-in 'Print the Rust source file for the compiled built-in peer list'
        }
        &'bbcli;help;peer;connect'= {
        }
        &'bbcli;help;peer;pin'= {
        }
        &'bbcli;help;peer;unpin'= {
        }
        &'bbcli;help;peer;list'= {
        }
        &'bbcli;help;peer;export-built-in'= {
        }
        &'bbcli;help;file'= {
            cand list 'Print the names of all files in the latest encrypted content blob'
            cand set 'Add or replace a file in the latest encrypted content blob'
            cand get 'Download a file from the latest encrypted content blob'
            cand delete 'Delete a file from the latest encrypted content blob'
        }
        &'bbcli;help;file;list'= {
        }
        &'bbcli;help;file;set'= {
        }
        &'bbcli;help;file;get'= {
        }
        &'bbcli;help;file;delete'= {
        }
        &'bbcli;help;contract'= {
            cand list 'Print current contract state for known peers'
            cand propose 'Form or renew a contract with a peer and print streamed updates'
            cand check 'Verify a peer contract and print streamed updates'
        }
        &'bbcli;help;contract;list'= {
        }
        &'bbcli;help;contract;propose'= {
        }
        &'bbcli;help;contract;check'= {
        }
        &'bbcli;help;recovery'= {
            cand run 'Recover the newest known local content version from peers'
            cand conflicts 'List unresolved and archived conflicting revisions'
            cand checkout 'Write one conflicting or archived revision to a local directory'
            cand resolve 'Choose the conflicting revision that should stay active'
        }
        &'bbcli;help;recovery;run'= {
        }
        &'bbcli;help;recovery;conflicts'= {
        }
        &'bbcli;help;recovery;checkout'= {
        }
        &'bbcli;help;recovery;resolve'= {
        }
        &'bbcli;help;config'= {
            cand get 'Print the current configuration and derived storage usage data'
            cand set 'Update one or more configuration fields'
        }
        &'bbcli;help;config;get'= {
        }
        &'bbcli;help;config;set'= {
        }
        &'bbcli;help;help'= {
        }
    ]
    $completions[$command]
}
