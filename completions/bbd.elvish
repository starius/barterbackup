
use builtin;
use str;

set edit:completion:arg-completer[bbd] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'bbd'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'bbd'= {
            cand --local-addr 'local_addr is the local loopback address for the CLI gRPC service'
            cand --data-dir 'data_dir is the base directory for all daemon state'
            cand --arti-config 'arti_config is one optional Arti TOML file for custom test networks'
            cand -h 'Print help'
            cand --help 'Print help'
        }
    ]
    $completions[$command]
}
